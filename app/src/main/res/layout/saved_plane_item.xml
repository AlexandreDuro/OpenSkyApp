<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#343A45"
    android:padding="16dp">

    <TextView
        android:id="@+id/icao24_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:text="ICAO24"
        android:textColor="#41B4E4"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/origin_country_text_view"
        app:layout_constraintEnd_toStartOf="@+id/callsign_text_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/callsign_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="4dp"
        android:text="Callsign"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@+id/velocity_text_view"
        app:layout_constraintEnd_toStartOf="@+id/delete_button"
        app:layout_constraintStart_toEndOf="@+id/icao24_text_view"
        app:layout_constraintTop_toTopOf="@+id/icao24_text_view"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/origin_country_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="4dp"
        android:text="Origin Country"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@+id/velocity_text_view"
        app:layout_constraintEnd_toStartOf="@+id/delete_button"
        app:layout_constraintStart_toEndOf="@+id/icao24_text_view"
        app:layout_constraintTop_toBottomOf="@+id/icao24_text_view" />

    <TextView
        android:id="@+id/velocity_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="4dp"
        android:text="Velocity"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@+id/altitude_text_view"
        app:layout_constraintEnd_toStartOf="@+id/delete_button"
        app:layout_constraintStart_toEndOf="@+id/icao24_text_view"
        app:layout_constraintTop_toBottomOf="@+id/origin_country_text_view" />

    <TextView
        android:id="@+id/altitude_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="4dp"
        android:text="Altitude"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/delete_button"
        app:layout_constraintStart_toEndOf="@+id/icao24_text_view"
        app:layout_constraintTop_toBottomOf="@+id/velocity_text_view" />

    <Button
        android:id="@+id/delete_button"
        style="@style/Widget.Material3.Button.TonalButton.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:text="Delete from list"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
